  "boundaries": [
    {
      "kind": "region",
      "label": "omarchy-shell (Quickshell process), one widget per monitor",
      "wraps": [
        "actions",
        "source",
        "model",
        "theme",
        "widget",
        "panel",
        "rows",
        "mark"
      ],
      "pad": 60
    },
    {
      "kind": "security-group",
      "label": "pure JS, no QML imports, no I/O",
      "wraps": [
        "actions",
        "source",
        "model",
        "theme"
      ]
    }
  ],
  "connections": [
    {
      "from": "site",
      "to": "widget",
      "label": "curl: list | probe",
      "variant": "emphasis"
    },
    {
      "from": "widget",
      "to": "panel",
      "label": "summary",
      "variant": "emphasis"
    },
    {
      "from": "panel",
      "to": "rows"
    },
    {
      "from": "widget",
      "to": "source",
      "fromSide": "top",
      "toSide": "bottom",
      "labelDy": -6
    },
    {
      "from": "panel",
      "to": "model",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "from": "tests",
      "to": "model",
      "label": "loads the same files",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDx": 70,
      "labelDy": 24
    },
    {
      "from": "widget",
      "to": "mark",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "orthogonal-v"
    },
    {
      "from": "widget",
      "to": "desktop",
      "label": "toast, open URL",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "orthogonal-v"
    },
    {
      "from": "widget",
      "to": "cache",
      "label": "write (leader)",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "orthogonal-v"
    },
    {
      "from": "widget",
      "to": "state",
      "label": "read marks",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "orthogonal-v"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Shell process",
      "items": [
        "BarWidget.qml: curl, two files, notify-send",
        "Panel / ItemRow / Mark only draw",
        "Leader = first instance in bar.moduleWidgets()"
      ]
    },
    {
      "dot": "rose",
      "title": "Pure JS",
      "items": [
        "Every rule lives in Model / Source / Actions / Theme",
        "No QML imports, so node can load them",
        "QML Array.sort is unstable: partition instead"
      ]
    },
    {
      "dot": "emerald",
      "title": "Files on disk",
      "items": [
        "Every instance watches both files (FileView)",
        "Only the leader writes the cache",
        "Delete state.json to reset to first run"
      ]
    },
    {
      "dot": "cyan",
      "title": "When it asks",
      "items": [
        "checkAt (09:30): the full list, ~130 KB",
        "Edition late: hourly probe /{date}, ~10 KB",
        "Probe 404 = not out yet; 200 = fetch the list",
        "429: hold everything until Retry-After"
      ]
    }
  ]
}
